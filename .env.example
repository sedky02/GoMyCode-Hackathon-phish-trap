# Claude API key (or use `ant auth login`)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Public base URL of this app, used inside planted canary links.
# For a real trap run `ngrok http 8000` and paste the https URL here.
CANARY_BASE_URL=http://localhost:8000

# local = Playwright on this machine, docker = isolated container (build sandbox/Dockerfile first)
SANDBOX_MODE=local

# Minimum agent confidence before submitting fake data
SUBMIT_THRESHOLD=0.6
